# Cashfree Payments
# Copy these names into your local .env.local file and replace the values.
# NEVER commit real Cashfree credentials to GitHub.

CASHFREE_ENVIRONMENT=sandbox
CASHFREE_CLIENT_ID=your_cashfree_client_id
CASHFREE_CLIENT_SECRET=your_cashfree_client_secret
CASHFREE_RETURN_URL=https://www.onlyroadtrip.com/payment/success

# Zoho SMTP - Plan Your Trip enquiries
# NEVER commit the real password/app password to GitHub.
ZOHO_SMTP_HOST=smtp.zoho.in
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=info@onlyroadtrip.com
ZOHO_SMTP_PASSWORD=your_zoho_password_or_app_password
ZOHO_FROM_EMAIL=info@onlyroadtrip.com
TRAVEL_ENQUIRY_TO=info@onlyroadtrip.com
